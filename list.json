{
  "$schema": "./schema/list.v1.schema.json",
  "schemaVersion": 1,
  "plugins": [
    {
      "id": "ai-chat",
      "kind": "plugin",
      "name": "AIChat",
      "description": "支持 OpenAI-compatible 服务、多模型、共享上下文、图片与文件输入和网络搜索的 AI 聊天插件。",
      "category": "ai",
      "authors": [
        {
          "name": "greepar",
          "url": "https://github.com/greepar"
        }
      ],
      "repository": "https://github.com/ShirokaProject/Shirobot.Plugin.AIChat",
      "license": "NOASSERTION",
      "compatibility": {
        "shirobot": ">=0.9.1 <1.0.0",
        "framework": "net10.0"
      },
      "release": {
        "required": true,
        "assetPattern": "ShiroBot.AiChatPlugin.dll"
      },
      "deprecated": false
    },
    {
      "id": "file-link",
      "kind": "plugin",
      "name": "FileLink",
      "description": "获取群文件直链，并支持从直链下载文件后保存到群文件的实用插件。",
      "category": "utility",
      "authors": [
        {
          "name": "greepar",
          "url": "https://github.com/greepar"
        }
      ],
      "repository": "https://github.com/ShirokaProject/Shirobot.Plugin.FileLink",
      "license": "GPL-3.0-only",
      "compatibility": {
        "shirobot": ">=0.9.1 <1.0.0",
        "framework": "net10.0"
      },
      "release": {
        "required": true,
        "assetPattern": "ShiroBot.Plugin.FileLink.zip"
      },
      "deprecated": false
    },
    {
      "id": "github-view",
      "kind": "plugin",
      "name": "GithubView",
      "description": "在聊天中展示 GitHub 仓库、Issue、README 和 Release，并支持仓库更新订阅。",
      "category": "utility",
      "authors": [
        {
          "name": "greepar",
          "url": "https://github.com/greepar"
        }
      ],
      "repository": "https://github.com/greepar/ShiroBot.Plugin.GithubView",
      "license": "GPL-3.0-only",
      "compatibility": {
        "shirobot": ">=0.9.1 <1.0.0",
        "framework": "net10.0"
      },
      "release": {
        "required": true,
        "assetPattern": "ShiroBot.Plugin.GithubView.dll"
      },
      "deprecated": false
    },
    {
      "id": "jm-parser",
      "kind": "plugin",
      "name": "JmParser",
      "description": "解析 JMComic 内容并生成适合聊天发送的图片或文档。",
      "category": "media",
      "authors": [
        {
          "name": "greepar",
          "url": "https://github.com/greepar"
        }
      ],
      "repository": "https://github.com/greepar/ShiroBot.Plugin.JmParser",
      "license": "GPL-3.0-only",
      "compatibility": {
        "shirobot": ">=0.9.1 <1.0.0",
        "framework": "net10.0"
      },
      "release": {
        "required": true,
        "assetPattern": "ShiroBot.JmParser.zip"
      },
      "deprecated": false
    },
    {
      "id": "my-list",
      "kind": "plugin",
      "name": "MyList",
      "description": "通过 WebDAV 提供群文件浏览、映射和管理能力。",
      "category": "utility",
      "authors": [
        {
          "name": "PVPGOOD",
          "url": "https://github.com/PVPGOOD"
        }
      ],
      "repository": "https://github.com/PVPGOOD/Shirobot.Plugin.MyList",
      "license": "MIT",
      "compatibility": {
        "shirobot": ">=0.9.1 <1.0.0",
        "framework": "net10.0"
      },
      "release": {
        "required": true,
        "assetPattern": "Shirobot.Plugin.MyList.dll"
      },
      "deprecated": false
    },
    {
      "id": "my-parser",
      "kind": "plugin",
      "name": "MyParser",
      "description": "解析哔哩哔哩、抖音、小红书、微信视频号、网易云音乐等平台链接并生成聊天预览。",
      "category": "media",
      "authors": [
        {
          "name": "PVPGOOD",
          "url": "https://github.com/PVPGOOD"
        }
      ],
      "repository": "https://github.com/ShirokaProject/Shirobot.Plugin.MyParser",
      "license": "Apache-2.0",
      "compatibility": {
        "shirobot": ">=0.9.1 <1.0.0",
        "framework": "net10.0"
      },
      "release": {
        "required": true,
        "assetPattern": "Shirobot.Plugin.MyParser.zip"
      },
      "deprecated": false
    },
    {
      "id": "onebot-server",
      "kind": "plugin",
      "name": "OneBot Server",
      "description": "将 ShiroBot 当前 QQ Adapter 的能力转换为 OneBot 11 HTTP、正向/反向 WebSocket 和 HTTP POST 服务。",
      "category": "infrastructure",
      "authors": [
        {
          "name": "ShirokaProject",
          "url": "https://github.com/ShirokaProject"
        }
      ],
      "repository": "https://github.com/ShirokaProject/ShiroBot.Plugin.OneBotServer",
      "license": "MIT",
      "compatibility": {
        "shirobot": ">=0.9.1 <1.0.0",
        "framework": "net10.0"
      },
      "release": {
        "required": true,
        "assetPattern": "ShiroBot.Plugin.OneBotServer.zip"
      },
      "deprecated": false
    },
    {
      "id": "video-previewer",
      "kind": "plugin",
      "name": "VideoPreviewer",
      "description": "通过回复视频消息生成视频预览的媒体辅助插件。",
      "category": "media",
      "authors": [
        {
          "name": "greepar",
          "url": "https://github.com/greepar"
        }
      ],
      "repository": "https://github.com/ShirokaProject/Shriobot.Plugin.VideoPreviewer",
      "license": "GPL-3.0-only",
      "compatibility": {
        "shirobot": ">=0.9.1 <1.0.0",
        "framework": "net10.0"
      },
      "release": {
        "required": true,
        "assetPattern": "ShiroBot.Plugin.VideoPreviewer.dll"
      },
      "deprecated": false
    }
  ]
}
